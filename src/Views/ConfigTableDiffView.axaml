<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:SourceGit.Converters"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             x:Class="SourceGit.Views.ConfigTableDiffView"
             x:DataType="vm:ConfigTableDiff">
  <Panel>
    <StackPanel IsVisible="{Binding !HasLoaded}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Spacing="12">
      <TextBlock Text="{DynamicResource Text.Diff.ConfigTable}" FontSize="18" FontWeight="Bold"
                 Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Center"/>
      <Path Width="56" Height="56" Data="{StaticResource Icons.Binary}" Fill="{DynamicResource Brush.FG2}"/>
      <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4"
            HorizontalAlignment="Center">
        <TextBlock Text="{DynamicResource Text.Diff.Old}"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                   Text="{Binding OldSize, Converter={x:Static c:LongConverters.ToFileSize}}"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource Text.Diff.New}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                   Text="{Binding NewSize, Converter={x:Static c:LongConverters.ToFileSize}}"/>
      </Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <Button Classes="flat primary" Content="{DynamicResource Text.Diff.ConfigTable.Open}"
                IsEnabled="{Binding !IsLoading}" Click="OnLoad"/>
        <Button Classes="flat" Content="{DynamicResource Text.Diff.ConfigTable.Hex}"
                IsVisible="{Binding CanOpenHex}" Click="OnOpenHex"/>
      </StackPanel>
      <StackPanel IsVisible="{Binding IsLoading}" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <v:LoadingIcon Width="16" Height="16"/>
        <TextBlock Text="{DynamicResource Text.Diff.ConfigTable.Loading}"/>
      </StackPanel>
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" MaxWidth="480"/>
    </StackPanel>

    <Grid IsVisible="{Binding HasLoaded}" RowDefinitions="Auto,*,Auto" Margin="8">
      <Button Classes="flat" HorizontalAlignment="Right" Margin="0,0,0,6"
              Content="{DynamicResource Text.Diff.ConfigTable.Hex}" IsVisible="{Binding CanOpenHex}" Click="OnOpenHex"/>
      <TextBlock Grid.Row="1" IsVisible="{Binding !HasChanges}"
                 Text="{DynamicResource Text.Diff.ConfigTable.NoChanges}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
      <v:ConfigTableDiffGrid Grid.Row="1" IsVisible="{Binding HasChanges}"
                             Comparison="{Binding Comparison}" CurrentCellChanged="OnCurrentCellChanged"
                             SelectionChanged="OnSelectedRowChanged"
                             SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
                             CanUserSortColumns="False" CanUserReorderColumns="False"
                             HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="26"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
      <Grid Grid.Row="2" x:Name="CellDetails" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0"
            IsVisible="False">
        <TextBox x:Name="BeforeValue" IsReadOnly="True" TextWrapping="Wrap"
                 MaxHeight="112" Watermark="{DynamicResource Text.Diff.Old}"
                 AutomationProperties.Name="{DynamicResource Text.Diff.Old}"/>
        <TextBox Grid.Column="1" x:Name="AfterValue" IsReadOnly="True" TextWrapping="Wrap"
                 MaxHeight="112" Watermark="{DynamicResource Text.Diff.New}"
                 AutomationProperties.Name="{DynamicResource Text.Diff.New}"/>
      </Grid>
    </Grid>
  </Panel>
</UserControl>
