<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <Style Selector="Button.toolbar_action">
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.toolbar_action > Path">
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.toolbar_label">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="MaxWidth" Value="78"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto,0,*" MinHeight="44">
    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,0,0,0">
      <Button Classes="icon_button" Width="32" Click="OpenWithExternalTools" ToolTip.Tip="{DynamicResource Text.Repository.OpenWithExternalTools}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.OpenWith}"/>
      </Button>

      <Button Classes="icon_button" Width="32" Click="OpenGitLogs" ToolTip.Tip="{DynamicResource Text.Repository.ViewLogs}">
        <Path Width="14" Height="14" Margin="0,1,0,0" Data="{StaticResource Icons.Logs}"/>
      </Button>

      <Button Classes="icon_button" Width="32" Click="OpenStatistics" ToolTip.Tip="{DynamicResource Text.Repository.Statistics}">
        <Path Width="13" Height="13" Margin="0,1.5,0,0" Data="{StaticResource Icons.Statistics}"/>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
      <Button Classes="icon_button toolbar_action" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Pull}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        
        <StackPanel Classes="toolbar_action">
          <Grid Width="24" Height="24" HorizontalAlignment="Center">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Pull}"/>
            <Ellipse Width="8" Height="8"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="Green"
                     IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Repository.Toolbar.Pull}"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button toolbar_action" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Push}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Classes="toolbar_action">
          <Grid Width="24" Height="24" HorizontalAlignment="Center">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Push}"/>
            <Ellipse Width="8" Height="8"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="Green"
                     IsVisible="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Repository.Toolbar.Push}"/>
        </StackPanel>
      </Button>

      <Rectangle Width="1" Height="16"
                 Margin="4,0"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource Brush.Border2}"/>

      <Button Classes="icon_button toolbar_action" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Repository.NewBranch}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+B, macOS=⌘+B}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel Classes="toolbar_action">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Repository.NewBranch}"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button toolbar_action" Click="OpenMergeRequest" ToolTip.Tip="{DynamicResource Text.CreateMergeRequest.Title}"
              IsEnabled="{Binding IsDashboardVisible}">
        <StackPanel Classes="toolbar_action">
          <Path Width="14" Height="14" Data="{StaticResource Icons.CreatePR}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.CreateMergeRequest.Toolbar}"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button toolbar_action" Click="OpenRemote" ToolTip.Tip="{DynamicResource Text.RemoteCM.OpenInBrowser}">
        <StackPanel Classes="toolbar_action">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Remotes}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Repository.Toolbar.Remote}"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button toolbar_action" Click="BrowseRepository" ToolTip.Tip="{DynamicResource Text.Repository.Explore}">
        <StackPanel Classes="toolbar_action">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Explore}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Repository.Toolbar.Browse}"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button toolbar_action" Click="OpenCustomActionMenu" ToolTip.Tip="{DynamicResource Text.Repository.CustomActions}">
        <StackPanel Classes="toolbar_action">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Action}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Repository.CustomActions}"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button toolbar_action" Click="OpenMoreMenu" ToolTip.Tip="{DynamicResource Text.Repository.Toolbar.More}">
        <StackPanel Classes="toolbar_action">
          <Path Width="14" Height="14" Data="{StaticResource Icons.More}"/>
          <TextBlock Classes="toolbar_label" Text="{DynamicResource Text.Repository.Toolbar.More}"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <Grid Grid.Column="3" HorizontalAlignment="Right" ColumnDefinitions="Auto,*,32,32,6">
      <Path Grid.Column="0"
            Width="13" Height="13"
            Margin="18,0,0,0"
            Data="{StaticResource Icons.Branch}"/>

      <Border Grid.Column="1"
              Margin="6,0"
              Background="Transparent"
              ToolTip.Tip="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}">
        <TextBlock Text="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}"
                   TextTrimming="CharacterEllipsis"/>
      </Border>

      <Button Grid.Column="2"
              Classes="icon_button"
              Width="32"
              Click="NavigateToHead"
              ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <Path Width="14" Height="14"
              Margin="0,1,0,0"
              Data="{StaticResource Icons.Target}"/>
      </Button>

      <ToggleButton Grid.Column="3"
                    Classes="line_path"
                    Width="32"
                    IsChecked="{Binding FocusOnCurrentBranch, Mode=TwoWay}"
                    ToolTip.Tip="{DynamicResource Text.Repository.FocusOnCurrentBranch}">
        <ToggleButton.Styles>
          <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="400"/>
          </Style>
        </ToggleButton.Styles>
        
        <Path Width="14" Height="14"
              Data="{StaticResource Icons.Magic}"/>
      </ToggleButton>
    </Grid>
  </Grid>
</UserControl>
